---
const { title = "Abbie's Angels", description = "Supporting caregivers and families navigating Alzheimer's disease in Western New York.", ogImage = "/images/abbies-angels-logo.jpg" } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{title}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={description}>
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={`https://abbies-angels.pages.dev${ogImage}`}>
  <meta property="og:url" content={`https://abbies-angels.pages.dev${currentPath}`}>
  <meta property="og:site_name" content="Abbie's Angels">
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={`https://abbies-angels.pages.dev${ogImage}`}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Lato:wght@400;700&display=swap" rel="stylesheet">
  <!-- HubSpot Tracking Code - replace YOUR_PORTAL_ID when connected -->
  <!-- <script type="text/javascript" id="hs-script-loader" async defer src="//js.hs-scripts.com/YOUR_PORTAL_ID.js"></script> -->
  <style>
    :root {
      --gold: #f4b321;
      --yellow: #ffd94a;
      --blue: #0055a4;
      --accent-red: #c8102e;
      --bg-light: #f7fafc;
      --text-main: #1a202c;
      --text-muted: #5a6475;
      --border-soft: #e2e8f0;
      --font-display: 'Nunito', system-ui, sans-serif;
      --font-body: 'Lato', system-ui, sans-serif;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: var(--font-body); color: var(--text-main); background: #ffffff; line-height: 1.65; }
    h1, h2, h3, h4 { font-family: var(--font-display); }
    a { color: var(--blue); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* ── Header ── */
    header {
      background: #ffffff;
      border-bottom: 1px solid var(--border-soft);
      padding: 10px 24px;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    .nav-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .brand {
      display: flex; align-items: center; gap: 12px;
      font-family: var(--font-display); font-weight: 800;
      font-size: 1.15rem; letter-spacing: 0.03em;
      color: var(--blue); text-decoration: none; flex-shrink: 0;
    }
    .brand:hover { text-decoration: none; }
    .brand-logo { width: 160px; height: auto; flex-shrink: 0; }
    .brand-logo img { width: 100%; height: auto; display: block; object-fit: contain; }

    /* ── Nav links ── */
    .nav-right { display: flex; align-items: center; gap: 6px; }
    .nav-links { display: flex; align-items: center; gap: 4px; font-size: 0.92rem; font-family: var(--font-display); }
    .nav-links a {
      color: var(--text-main); font-weight: 600;
      padding: 6px 10px; border-radius: 6px;
      transition: color 0.15s, background 0.15s;
    }
    .nav-links a:hover { color: var(--blue); background: #f0f4fb; text-decoration: none; }
    .nav-links a.active { color: var(--blue); background: #e8f0fb; }

    /* ── Dropdown ── */
    .nav-dropdown { position: relative; }
    .nav-dropdown > button {
      display: flex; align-items: center; gap: 4px;
      color: var(--text-main); font-weight: 600; font-size: 0.92rem;
      font-family: var(--font-display); padding: 6px 10px; border-radius: 6px;
      background: none; border: none; cursor: pointer;
      transition: color 0.15s, background 0.15s;
    }
    .nav-dropdown > button:hover { color: var(--blue); background: #f0f4fb; }
    .nav-dropdown > button svg { transition: transform 0.2s; }
    .nav-dropdown.open > button svg { transform: rotate(180deg); }
    .nav-dropdown > button.active { color: var(--blue); background: #e8f0fb; }
    .dropdown-menu {
      display: none;
      position: absolute; top: calc(100% + 6px); right: 0;
      background: #fff; border: 1px solid var(--border-soft);
      border-radius: 12px; box-shadow: 0 8px 28px rgba(15,23,42,0.12);
      min-width: 180px; padding: 6px;
      z-index: 200;
    }
    .nav-dropdown.open .dropdown-menu { display: block; }
    .dropdown-menu a {
      display: flex; align-items: center; gap: 8px;
      padding: 9px 12px; border-radius: 8px;
      font-size: 0.9rem; font-weight: 600; font-family: var(--font-display);
      color: var(--text-main); transition: background 0.12s, color 0.12s;
    }
    .dropdown-menu a:hover { background: #f0f4fb; color: var(--blue); text-decoration: none; }
    .dropdown-menu a.active { background: #e8f0fb; color: var(--blue); }
    .dropdown-menu .divider { height: 1px; background: var(--border-soft); margin: 4px 0; }

    /* ── Donate CTA pill ── */
    .btn-nav-donate {
      display: inline-flex; align-items: center;
      padding: 7px 18px; border-radius: 999px;
      background: var(--accent-red); color: #fff !important;
      font-weight: 700; font-size: 0.88rem;
      font-family: var(--font-display);
      border: none; cursor: pointer; text-decoration: none;
      box-shadow: 0 2px 8px rgba(200,16,46,0.25);
      transition: background 0.15s, transform 0.15s, box-shadow 0.15s;
      margin-left: 8px;
    }
    .btn-nav-donate:hover { background: #9e0b23; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(200,16,46,0.3); text-decoration: none; }

    /* ── Mobile hamburger ── */
    .nav-hamburger {
      display: none; flex-direction: column; gap: 5px;
      background: none; border: none; cursor: pointer; padding: 6px;
    }
    .nav-hamburger span { display: block; width: 22px; height: 2px; background: var(--text-main); border-radius: 2px; transition: all 0.2s; }
    .mobile-menu {
      display: none; flex-direction: column; gap: 2px;
      padding: 12px 16px 16px; border-top: 1px solid var(--border-soft);
      background: #fff;
    }
    .mobile-menu.open { display: flex; }
    .mobile-menu a, .mobile-menu .mobile-section-label {
      padding: 9px 12px; border-radius: 8px;
      font-size: 0.95rem; font-weight: 600;
      font-family: var(--font-display); color: var(--text-main);
    }
    .mobile-menu a:hover { background: #f0f4fb; color: var(--blue); text-decoration: none; }
    .mobile-menu a.active { background: #e8f0fb; color: var(--blue); }
    .mobile-section-label { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); padding-top: 14px; }
    .mobile-menu .btn-nav-donate { margin: 10px 12px 0; justify-content: center; }

    /* ── Mobile sticky donate bar ── */
    .mobile-sticky-donate {
      display: none;
      position: fixed; bottom: 0; left: 0; right: 0;
      z-index: 200;
      padding: 10px 16px;
      padding-bottom: max(10px, env(safe-area-inset-bottom));
      background: rgba(255,255,255,0.96);
      border-top: 1px solid var(--border-soft);
      box-shadow: 0 -4px 16px rgba(0,0,0,0.08);
      backdrop-filter: blur(8px);
    }
    .mobile-sticky-donate a {
      display: flex; align-items: center; justify-content: center;
      width: 100%; padding: 13px; border-radius: 999px;
      background: var(--accent-red); color: #fff;
      font-weight: 800; font-size: 1rem; font-family: var(--font-display);
      text-decoration: none; box-shadow: 0 4px 14px rgba(200,16,46,0.3);
      transition: background 0.15s;
    }
    .mobile-sticky-donate a:hover { background: #9e0b23; text-decoration: none; }

    /* ── Footer ── */
    footer {
      border-top: 3px solid var(--gold);
      padding: 40px 24px 24px;
      background: #f9fafb;
      font-size: 0.88rem;
      color: var(--text-muted);
      /* account for mobile sticky bar */
      padding-bottom: max(24px, calc(env(safe-area-inset-bottom) + 24px));
    }
    .footer-top {
      max-width: 1100px;
      margin: 0 auto 28px;
      display: grid;
      grid-template-columns: 1.8fr 1fr 1fr 1fr;
      gap: 32px;
      align-items: start;
    }
    .footer-brand img { width: 140px; height: auto; margin-bottom: 10px; }
    .footer-brand p { font-size: 0.83rem; line-height: 1.6; max-width: 240px; }
    .footer-col h4 { font-family: var(--font-display); font-weight: 800; font-size: 0.88rem; color: var(--text-main); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 10px; }
    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 7px; }
    .footer-col ul a { color: var(--text-muted); font-size: 0.85rem; font-weight: 500; transition: color 0.15s; }
    .footer-col ul a:hover { color: var(--blue); text-decoration: none; }
    .footer-bottom {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      border-top: 1px solid var(--border-soft);
      padding-top: 20px;
      flex-wrap: wrap;
    }
    .footer-copy { font-size: 0.82rem; }
    .footer-social { display: flex; align-items: center; gap: 10px; }
    .footer-social a {
      display: flex; align-items: center; justify-content: center;
      width: 34px; height: 34px; border-radius: 50%;
      background: #fff; border: 1px solid var(--border-soft);
      box-shadow: 0 1px 4px rgba(0,0,0,0.07);
      transition: transform 0.15s, box-shadow 0.15s; text-decoration: none;
    }
    .footer-social a:hover { transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0,0,0,0.12); text-decoration: none; }
    .footer-social svg { width: 16px; height: 16px; display: block; }
    .visitor-count { font-size: 0.82em; white-space: nowrap; }
    .visitor-count img { height: 1.1em; vertical-align: middle; margin-left: 0.3em; }

    @media (max-width: 900px) {
      .footer-top { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 768px) {
      .nav-links, .nav-dropdown, .btn-nav-donate { display: none; }
      .nav-hamburger { display: flex; }
      .footer-top { grid-template-columns: 1fr 1fr; gap: 20px; }
      .footer-bottom { flex-direction: column; align-items: center; text-align: center; }
      .mobile-sticky-donate { display: block; }
      footer { padding-bottom: max(80px, calc(env(safe-area-inset-bottom) + 72px)); }
    }
    @media (max-width: 480px) {
      .footer-top { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
<header>
  <div class="nav-inner">
    <a class="brand" href="/">
      <div class="brand-logo">
        <img src="/images/abbies-angels-logo.jpg" alt="Abbie's Angels logo">
      </div>
    </a>
    <div class="nav-right">
      <nav class="nav-links">
        <a href="/#mission" class={currentPath === '/' ? 'active' : ''}>Mission</a>
        <a href="/events" class={currentPath.startsWith('/events') ? 'active' : ''}>Events</a>
        <a href="/gallery" class={currentPath.startsWith('/gallery') ? 'active' : ''}>Gallery</a>
        <a href="/#team" class={currentPath === '/' ? '' : ''}>Team</a>
      </nav>
      <!-- Get Involved dropdown -->
      <div class="nav-dropdown" id="nav-get-involved">
        <button
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="dropdown-get-involved"
          class={['/volunteer','/sponsor','/donate','/contact'].some(p => currentPath.startsWith(p)) ? 'active' : ''}
        >
          Get Involved
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="dropdown-menu" id="dropdown-get-involved" role="menu">
          <a href="/volunteer" class={currentPath.startsWith('/volunteer') ? 'active' : ''} role="menuitem">🙋 Volunteer</a>
          <a href="/sponsor" class={currentPath.startsWith('/sponsor') ? 'active' : ''} role="menuitem">🤝 Sponsor</a>
          <a href="/donate" class={currentPath.startsWith('/donate') ? 'active' : ''} role="menuitem">❤️ Donate</a>
          <div class="divider"></div>
          <a href="/contact" class={currentPath.startsWith('/contact') ? 'active' : ''} role="menuitem">✉️ Contact Us</a>
        </div>
      </div>
      <a class="btn-nav-donate" href="/donate">Donate</a>
    </div>
    <!-- Mobile hamburger -->
    <button class="nav-hamburger" id="nav-hamburger" aria-label="Open navigation" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
  <!-- Mobile menu -->
  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation">
    <a href="/#mission" class={currentPath === '/' ? 'active' : ''}>Mission</a>
    <a href="/events" class={currentPath.startsWith('/events') ? 'active' : ''}>Events</a>
    <a href="/gallery" class={currentPath.startsWith('/gallery') ? 'active' : ''}>Gallery</a>
    <a href="/#team">Team</a>
    <div class="mobile-section-label">Get Involved</div>
    <a href="/volunteer" class={currentPath.startsWith('/volunteer') ? 'active' : ''}>🙋 Volunteer</a>
    <a href="/sponsor" class={currentPath.startsWith('/sponsor') ? 'active' : ''}>🤝 Sponsor</a>
    <a href="/contact" class={currentPath.startsWith('/contact') ? 'active' : ''}>✉️ Contact Us</a>
    <a class="btn-nav-donate" href="/donate">❤️ Donate Now</a>
  </nav>
</header>

<slot />

<!-- Mobile sticky donate bar -->
<div class="mobile-sticky-donate" aria-hidden="true">
  <a href="/donate">❤️ Donate to Abbie's Angels</a>
</div>

<footer>
  <div class="footer-top">
    <div class="footer-brand">
      <img src="/images/abbies-angels-logo.jpg" alt="Abbie's Angels">
      <p>Supporting caregivers and families navigating Alzheimer's disease in Western New York.</p>
      <p style="margin-top:8px; font-size:0.8rem;">501(c)(3) Nonprofit &bull; EIN: 33-2629458</p>
    </div>
    <div class="footer-col">
      <h4>About</h4>
      <ul>
        <li><a href="/#mission">Our Mission</a></li>
        <li><a href="/#what-we-do">What We Do</a></li>
        <li><a href="/#team">Our Team</a></li>
        <li><a href="/gallery">Gallery</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Events</h4>
      <ul>
        <li><a href="/events">All Events</a></li>
        <li><a href="/events">Upcoming</a></li>
        <li><a href="/sponsor">Sponsor an Event</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Get Involved</h4>
      <ul>
        <li><a href="/donate">Donate</a></li>
        <li><a href="/volunteer">Volunteer</a></li>
        <li><a href="/sponsor">Sponsor</a></li>
        <li><a href="/contact">Contact Us</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-copy">
      <div>&copy; {new Date().getFullYear()} Abbie&#39;s Angels. All rights reserved. &bull; Lockport, NY</div>
    </div>
    <div class="footer-social">
      <a href="https://www.facebook.com/abbiesangels" target="_blank" rel="noopener" aria-label="Facebook">
        <svg viewBox="0 0 24 24" fill="#1877F2" aria-hidden="true"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.268h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>
      </a>
      <a href="https://www.instagram.com/abbiesangels" target="_blank" rel="noopener" aria-label="Instagram">
        <svg viewBox="0 0 24 24" fill="#E4405F" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162S8.597 18.163 12 18.163s6.162-2.759 6.162-6.163S15.403 5.838 12 5.838zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
      </a>
      <a href="https://www.linkedin.com/company/abbies-angels" target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" fill="#0A66C2" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
    </div>
    <span class="visitor-count">Visitors <img src="https://www.counter12.com/img-Ay85cc0B51W9W3D5-31.gif" alt="Visitor count"></span>
  </div>
</footer>

<script>
  // Dropdown toggle
  const dropdown = document.getElementById('nav-get-involved');
  const dropBtn = dropdown?.querySelector('button');
  dropBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = dropdown.classList.toggle('open');
    dropBtn.setAttribute('aria-expanded', open);
  });
  document.addEventListener('click', () => {
    dropdown?.classList.remove('open');
    dropBtn?.setAttribute('aria-expanded', 'false');
  });
  // Mobile hamburger
  const hamburger = document.getElementById('nav-hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  hamburger?.addEventListener('click', () => {
    const open = mobileMenu.classList.toggle('open');
    hamburger.setAttribute('aria-expanded', open);
  });
  // Hide mobile sticky donate bar on donate page
  if (window.location.pathname.startsWith('/donate')) {
    document.querySelector('.mobile-sticky-donate')?.remove();
  }
</script>
</body>
</html>
