---
import Base from '../layouts/Base.astro';
import { getSingleton } from '../lib/sanity';

const v = await getSingleton('volunteer');
const roles = Array.isArray(v?.roles) ? v.roles : [];
const HS_PORTAL = v?.hubspot_portal_id || '244584127';
const HS_REGION = v?.hubspot_region || 'na2';
const HS_FORM_ID = v?.hubspot_form_id || '19fc03ac-21cf-4c0b-b012-17dd67d84ee6';
---
<Base title="Volunteer — Abbie's Angels">
<style>
  .page-hero {
    background: linear-gradient(135deg, #eaf1fb 0%, #ffffff 60%, #fff8e7 100%);
    padding: 48px 16px 36px;
    border-bottom: 1px solid var(--border-soft);
    text-align: center;
  }
  .page-hero h1 { font-size: 2rem; color: var(--blue); font-weight: 800; margin-bottom: 10px; }
  .page-hero p { color: var(--text-muted); font-size: 1rem; max-width: 560px; margin: 0 auto; }
  main { max-width: 720px; margin: 44px auto 64px; padding: 0 16px; }
  .card {
    background: #fff; border-radius: 16px; padding: 32px;
    border: 1px solid var(--border-soft);
    box-shadow: 0 4px 16px rgba(15,23,42,0.05);
  }
  .card h2 { font-size: 1.15rem; margin-bottom: 10px; color: var(--blue); font-weight: 800;
    border-left: 4px solid var(--gold); padding-left: 10px; }
  .card p { font-size: 0.93rem; color: var(--text-muted); margin-bottom: 16px; line-height: 1.65; }
  .roles { list-style: none; padding: 0; margin: 0 0 24px; display: grid;
    grid-template-columns: 1fr 1fr; gap: 8px 20px; }
  .roles li { font-size: 0.92rem; color: var(--text-main); padding-left: 22px; position: relative; }
  .roles li::before { content: '💛'; position: absolute; left: 0; }
  /* HubSpot form frame */
  .hs-form-frame { width: 100%; }
  @media (max-width: 560px) { .roles { grid-template-columns: 1fr; } }
</style>

<div class="page-hero">
  <h1>{v?.heading || 'Volunteer With Us'}</h1>
  <p>{v?.subheading || "Abbie's Angels runs entirely on the time and talents of volunteers like you. Fill out the form below and we'll be in touch!"}</p>
</div>

<main>
  <div class="card">
    <h2>{v?.form_heading || 'Volunteer Application'}</h2>
    <p>{v?.form_intro || "Tell us a little about yourself and how you'd like to help. Our team will reach out to discuss opportunities."}</p>
    {roles.length > 0 && (
      <ul class="roles">
        {roles.map((r: string) => <li>{r}</li>)}
      </ul>
    )}
    <script is:inline src={`https://js-${HS_REGION}.hsforms.net/forms/embed/${HS_PORTAL}.js`} defer></script>
    <div class="hs-form-frame" data-region={HS_REGION} data-form-id={HS_FORM_ID} data-portal-id={HS_PORTAL}></div>
  </div>
</main>
</Base>
