---
import Base from '../layouts/Base.astro';
import { createClient } from '@sanity/client';

const client = createClient({
  projectId: '7o31gm3n',
  dataset: 'production',
  apiVersion: '2024-01-01',
  useCdn: true,
});

const vol = await client.fetch(`*[_type == "volunteer"][0]`);

const defaultRoles = [
  '🎪 Event Setup & Teardown',
  '🎟 Ticket & Check-In',
  '📸 Photography',
  '📱 Social Media',
  '🍽 Food & Beverage',
  '📦 Auction Support',
  '🧾 Admin & Office',
  '💬 Community Outreach',
];

const roles: string[] = vol?.roles_section?.roles?.length ? vol.roles_section.roles : defaultRoles;
---
<Base title="Volunteer — Abbie's Angels">
<style>
  .page-hero {
    background: linear-gradient(135deg, #eaf1fb 0%, #ffffff 60%, #f0faf0 100%);
    padding: 48px 16px 36px;
    border-bottom: 1px solid var(--border-soft);
    text-align: center;
  }
  .page-hero h1 { font-size: 2rem; color: var(--blue); font-weight: 800; margin-bottom: 10px; }
  .page-hero p { color: var(--text-muted); font-size: 1rem; max-width: 560px; margin: 0 auto; }
  main { max-width: 900px; margin: 44px auto 64px; padding: 0 16px; }
  .card {
    background: #fff; border-radius: 16px; padding: 24px 28px;
    border: 1px solid var(--border-soft);
    box-shadow: 0 4px 16px rgba(15,23,42,0.05);
    margin-bottom: 24px;
  }
  .card h2 { font-size: 1.15rem; margin-bottom: 10px; color: var(--blue); font-weight: 800;
    border-left: 4px solid var(--gold); padding-left: 10px; }
  .card p { font-size: 0.95rem; color: var(--text-muted); margin-bottom: 10px; line-height: 1.7; }
  .role-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px,1fr)); gap: 14px; margin: 14px 0; }
  .role-chip {
    background: #f4f6fb; border: 1px solid var(--border-soft); border-radius: 10px;
    padding: 12px 16px; font-size: 0.9rem; font-weight: 600; color: var(--blue);
    text-align: center;
  }
  .form-group { margin-bottom: 16px; }
  .form-group label { display: block; font-size: 0.88rem; font-weight: 700; margin-bottom: 5px; color: var(--text-main); }
  .form-group input, .form-group textarea, .form-group select {
    width: 100%; padding: 10px 14px; border-radius: 8px;
    border: 1px solid var(--border-soft); font-size: 0.95rem;
    font-family: var(--font-body); background: #fafafa;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .form-group input:focus, .form-group textarea:focus, .form-group select:focus {
    outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(0,85,164,0.12);
  }
  .form-group textarea { min-height: 90px; resize: vertical; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 11px 26px; border-radius: 999px; font-size: 0.95rem; font-weight: 700;
    font-family: var(--font-display); border: 2px solid transparent; cursor: pointer;
    text-decoration: none; transition: transform 0.15s, box-shadow 0.15s, background 0.15s;
  }
  .btn-primary { background: var(--blue); color: #fff; border-color: var(--blue); box-shadow: 0 4px 14px rgba(0,85,164,0.2); }
  .btn-primary:hover { background: #00346b; border-color: #00346b; transform: translateY(-2px); text-decoration: none; }
  @media (max-width: 640px) { .page-hero h1 { font-size: 1.6rem; } }
</style>

<div class="page-hero">
  <h1>{vol?.hero_heading || 'Volunteer With Us'}</h1>
  <p>{vol?.hero_subheading || "Abbie's Angels runs entirely on volunteer power. Whether you can help at an event or behind the scenes, there's a place for you."}</p>
</div>

<main>
  <div class="card">
    <h2>{vol?.roles_section?.heading || 'Ways to Volunteer'}</h2>
    <div class="role-grid">
      {roles.map((role: string) => (
        <div class="role-chip">{role}</div>
      ))}
    </div>
  </div>

  <div class="card">
    <h2>{vol?.form_section?.heading || 'Volunteer Interest Form'}</h2>
    <p>{vol?.form_section?.intro || "Tell us a little about yourself and we'll reach out when opportunities match your interests."}</p>
    <!-- HubSpot embed target: replace form with hbspt.forms.create({ portalId: "YOUR_ID", formId: "volunteer-form-id" }) -->
    <div id="hs-volunteer-form">
      <form action="/thank-you" method="GET" novalidate>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
          <div class="form-group">
            <label for="vol_first">First Name</label>
            <input type="text" id="vol_first" name="firstname" placeholder="Jane" required>
          </div>
          <div class="form-group">
            <label for="vol_last">Last Name</label>
            <input type="text" id="vol_last" name="lastname" placeholder="Smith" required>
          </div>
        </div>
        <div class="form-group">
          <label for="vol_email">Email Address</label>
          <input type="email" id="vol_email" name="email" placeholder="jane@example.com" required>
        </div>
        <div class="form-group">
          <label for="vol_phone">Phone (optional)</label>
          <input type="tel" id="vol_phone" name="phone" placeholder="(716) 555-0100">
        </div>
        <div class="form-group">
          <label for="vol_interest">Areas of Interest</label>
          <select id="vol_interest" name="vol_interest">
            <option value="events">Event Volunteering</option>
            <option value="photography">Photography / Media</option>
            <option value="social">Social Media</option>
            <option value="admin">Admin / Office</option>
            <option value="outreach">Community Outreach</option>
            <option value="any">Wherever I'm needed</option>
          </select>
        </div>
        <div class="form-group">
          <label for="vol_note">Anything else we should know?</label>
          <textarea id="vol_note" name="message" placeholder="Skills, availability, etc."></textarea>
        </div>
        <button type="submit" class="btn btn-primary">{vol?.form_section?.submit_label || 'Submit Interest Form'}</button>
      </form>
    </div>
  </div>
</main>
</Base>
