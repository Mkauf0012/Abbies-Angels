---
import Base from '../layouts/Base.astro';
import { client } from '../lib/sanity';

const ty = await client.fetch(`*[_type == "thank_you"][0]`);
---
<Base title="Thank You — Abbie's Angels">
<!-- HubSpot conversion tracking fires here. Add pixel/event below when portal connected. -->
<!-- <script>if(window._hsq){window._hsq.push(['trackEvent',{id:'Form Submission'}]);}</script> -->
<style>
  .ty-wrap {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 64px 16px;
    text-align: center;
  }
  .ty-icon {
    font-size: 4rem;
    margin-bottom: 16px;
    animation: pop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
  }
  @keyframes pop {
    0% { transform: scale(0.5); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }
  .ty-wrap h1 {
    font-size: 2.2rem; color: var(--blue); font-weight: 800; margin-bottom: 12px;
  }
  .ty-wrap p {
    font-size: 1rem; color: var(--text-muted); max-width: 520px;
    margin: 0 auto 28px; line-height: 1.75;
  }
  .next-steps {
    display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 8px;
  }
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 11px 24px; border-radius: 999px; font-size: 0.95rem; font-weight: 700;
    font-family: var(--font-display); border: 2px solid transparent; cursor: pointer;
    text-decoration: none; transition: transform 0.15s, background 0.15s;
  }
  .btn-primary { background: var(--blue); color: #fff; border-color: var(--blue); }
  .btn-primary:hover { background: #00346b; transform: translateY(-2px); text-decoration: none; }
  .btn-outline { background: #fff; color: var(--blue); border-color: var(--blue); }
  .btn-outline:hover { background: var(--blue); color: #fff; text-decoration: none; }
  .btn-gold { background: var(--gold); color: #000; border-color: var(--gold); }
  .btn-gold:hover { background: #d99e10; transform: translateY(-2px); text-decoration: none; }
</style>

<div class="ty-wrap">
  <div class="ty-icon">❤️</div>
  <h1>{ty?.heading || 'Thank You!'}</h1>
  <p>{ty?.body || "We've received your message and truly appreciate you connecting with Abbie's Angels. A member of our volunteer team will follow up with you shortly."}</p>
  <div class="next-steps">
    <a class="btn btn-primary" href={ty?.back_url || '/'}>{ty?.back_label || '← Back to Home'}</a>
    <a class="btn btn-gold" href="/events">View Upcoming Events</a>
    <a class="btn btn-outline" href="/donate">Make a Donation</a>
  </div>
</div>
</Base>
