---
import Base from '../layouts/Base.astro';
import { createClient } from '@sanity/client';

const client = createClient({
  projectId: '7o31gm3n',
  dataset: 'production',
  apiVersion: '2024-01-01',
  useCdn: true,
});

const contact = await client.fetch(`*[_type == "contact"][0]`);
---
<Base title="Contact Us — Abbie's Angels">
<style>
  .page-hero {
    background: linear-gradient(135deg, #eaf1fb 0%, #ffffff 60%, #fff8e7 100%);
    padding: 48px 16px 36px;
    border-bottom: 1px solid var(--border-soft);
    text-align: center;
  }
  .page-hero h1 { font-size: 2rem; color: var(--blue); font-weight: 800; margin-bottom: 10px; }
  .page-hero p { color: var(--text-muted); font-size: 1rem; max-width: 560px; margin: 0 auto; }
  main { max-width: 1100px; margin: 44px auto 64px; padding: 0 16px; }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-top: 8px;
  }
  .card {
    background: #fff; border-radius: 16px; padding: 24px 24px;
    border: 1px solid var(--border-soft);
    box-shadow: 0 4px 16px rgba(15,23,42,0.05);
  }
  .card h2 { font-size: 1.15rem; margin-bottom: 10px; color: var(--blue); font-weight: 800;
    border-left: 4px solid var(--gold); padding-left: 10px; }
  .card p { font-size: 0.93rem; color: var(--text-muted); margin-bottom: 10px; line-height: 1.65; }
  /* HubSpot form placeholder */
  .hs-form-placeholder {
    border: 2px dashed var(--border-soft);
    border-radius: 12px;
    padding: 32px 24px;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-top: 8px;
  }
  .hs-form-placeholder strong { display: block; margin-bottom: 6px; color: var(--text-main); font-size: 1rem; }
  /* Interim contact form */
  .form-group { margin-bottom: 16px; }
  .form-group label { display: block; font-size: 0.88rem; font-weight: 700; margin-bottom: 5px; color: var(--text-main); }
  .form-group input, .form-group textarea, .form-group select {
    width: 100%; padding: 10px 14px; border-radius: 8px;
    border: 1px solid var(--border-soft); font-size: 0.95rem;
    font-family: var(--font-body); background: #fafafa;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .form-group input:focus, .form-group textarea:focus, .form-group select:focus {
    outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(0,85,164,0.12);
  }
  .form-group textarea { min-height: 110px; resize: vertical; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 11px 26px; border-radius: 999px; font-size: 0.95rem; font-weight: 700;
    font-family: var(--font-display); border: 2px solid transparent; cursor: pointer;
    text-decoration: none; transition: transform 0.15s, box-shadow 0.15s, background 0.15s;
  }
  .btn-primary { background: var(--blue); color: #fff; border-color: var(--blue); box-shadow: 0 4px 14px rgba(0,85,164,0.2); }
  .btn-primary:hover { background: #00346b; border-color: #00346b; transform: translateY(-2px); text-decoration: none; }
  .social-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
  .social-pill {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 7px 14px 7px 10px; border-radius: 999px;
    background: #f4f6fb; border: 1px solid var(--border-soft);
    font-size: 0.88rem; font-weight: 600; color: var(--text-main);
    text-decoration: none; transition: background 0.15s, transform 0.15s;
  }
  .social-pill:hover { background: #e8edf8; transform: translateY(-1px); text-decoration: none; }
  .social-pill svg { width: 18px; height: 18px; display: block; flex-shrink: 0; }
  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; }
    .page-hero h1 { font-size: 1.6rem; }
  }
</style>

<div class="page-hero">
  <h1>Get in Touch</h1>
  <p>{contact?.intro || "We\'d love to hear from you. Reach out with questions, volunteer inquiries, or sponsorship interest."}</p>
</div>

<main>
  <div class="contact-grid">
    <!-- Left: Contact Form (HubSpot-ready) -->
    <div class="card">
      <h2>Send Us a Message</h2>
      <p>Fill out the form below and a member of our team will get back to you soon.</p>
      <!-- HubSpot embed target: replace form below with hbspt.forms.create({...}) when ready -->
      <div id="hs-contact-form">
        <form action="/thank-you" method="GET" novalidate>
          <div class="form-group">
            <label for="firstname">First Name</label>
            <input type="text" id="firstname" name="firstname" placeholder="Jane" required>
          </div>
          <div class="form-group">
            <label for="lastname">Last Name</label>
            <input type="text" id="lastname" name="lastname" placeholder="Smith" required>
          </div>
          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="jane@example.com" required>
          </div>
          <div class="form-group">
            <label for="interest">I'm interested in…</label>
            <select id="interest" name="interest">
              <option value="general">General Question</option>
              <option value="volunteer">Volunteering</option>
              <option value="donate">Donating / Sponsorship</option>
              <option value="event">Event Information</option>
              <option value="media">Media / Press</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="How can we help?"></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Send Message</button>
        </form>
      </div>
    </div>

    <!-- Right: Info cards -->
    <div style="display:flex; flex-direction:column; gap:20px;">
      <div class="card">
        <h2>Follow Along</h2>
        <p>Message us on social — our volunteer team responds as soon as possible.</p>
        <div class="social-row">
          {contact?.facebook && (
            <a class="social-pill" href={contact.facebook} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="#1877F2" aria-hidden="true"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.268h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>
              Facebook
            </a>
          )}
          {contact?.instagram && (
            <a class="social-pill" href={contact.instagram} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="#E4405F" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162S8.597 18.163 12 18.163s6.162-2.759 6.162-6.163S15.403 5.838 12 5.838zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              Instagram
            </a>
          )}
          {contact?.linkedin && (
            <a class="social-pill" href={contact.linkedin} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="#0A66C2" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
          )}
        </div>
      </div>

      <div class="card">
        <h2>Mailing Address</h2>
        <p>{contact?.mailing_name || "Abbie's Angels"}<br/>
        {contact?.mailing_street || ''}<br/>
        {contact?.mailing_city || 'Lockport, NY'}</p>
        {contact?.email && <p style="margin-top:10px;">Email: <a href={`mailto:${contact.email}`}>{contact.email}</a></p>}
      </div>

      <div class="card">
        <h2>Other Ways to Help</h2>
        <p>Interested in volunteering, sponsoring an event, or making a donation?</p>
        <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:10px;">
          <a class="btn btn-primary" href="/volunteer" style="font-size:0.88rem; padding:8px 18px;">Volunteer</a>
          <a class="btn btn-primary" href="/sponsor" style="font-size:0.88rem; padding:8px 18px; background:var(--gold); border-color:var(--gold); color:#000;">Sponsor</a>
          <a class="btn btn-primary" href="/donate" style="font-size:0.88rem; padding:8px 18px; background:var(--accent-red); border-color:var(--accent-red);">Donate</a>
        </div>
      </div>
    </div>
  </div>
</main>
</Base>
