---
import Base from '../layouts/Base.astro';
---
<Base title="Welcome to the Family — Abbie's Angels" description="You're officially part of the Abbie's Angels community. Thank you for subscribing!">
<style>
  /* ── Page wrapper ── */
  .page-bg {
    background-color: #f5f3ef;
    min-height: 100vh;
    padding: 32px 16px 64px;
    font-family: Arial, Helvetica, sans-serif;
  }

  /* ── Card container ── */
  .card-wrap {
    max-width: 600px;
    width: 100%;
    margin: 0 auto;
    background: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 16px rgba(0,0,0,0.08);
  }

  /* ── Header ── */
  .card-header {
    background-color: #7c4a8f;
    padding: 28px 40px;
    text-align: center;
  }
  .card-header .brand-name {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 26px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.5px;
    line-height: 1.2;
    margin: 0;
  }
  .card-header .brand-sub {
    font-size: 11px;
    color: rgba(255,255,255,0.8);
    margin-top: 6px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  /* ── Hero greeting ── */
  .hero-section {
    padding: 48px 40px 36px;
    text-align: center;
    background: #ffffff;
  }
  .eyebrow {
    font-size: 11px;
    color: #9b7db0;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin: 0 0 16px 0;
  }
  .hero-heading {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 28px;
    line-height: 1.4;
    color: #2d1a3e;
    margin: 0 0 20px 0;
    font-weight: 700;
  }
  .hero-body {
    font-size: 15px;
    line-height: 1.7;
    color: #555555;
    margin: 0 0 28px 0;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }
  .btn-primary {
    display: inline-block;
    background-color: #7c4a8f;
    color: #ffffff;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    padding: 14px 32px;
    border-radius: 50px;
    transition: background 0.15s;
  }
  .btn-primary:hover { background-color: #5f3570; text-decoration: none; }

  /* ── Divider ── */
  .divider { padding: 0 40px; }
  .divider hr { border: none; border-top: 1px solid #ede9f4; margin: 0; }

  /* ── Mission block ── */
  .mission-section {
    padding: 36px 40px;
    background-color: #faf8fd;
    text-align: center;
  }
  .mission-section .eyebrow { margin-bottom: 12px; }
  .mission-quote {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 18px;
    line-height: 1.7;
    color: #2d1a3e;
    font-style: italic;
    margin: 0 0 16px 0;
  }
  .mission-body {
    font-size: 14px;
    line-height: 1.7;
    color: #666666;
    margin: 0;
    max-width: 460px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ── What's coming ── */
  .coming-section {
    padding: 36px 40px;
    background: #ffffff;
  }
  .coming-section .eyebrow {
    text-align: center;
    margin-bottom: 24px;
  }
  .coming-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 22px;
  }
  .coming-item:last-child { margin-bottom: 0; }
  .coming-icon {
    width: 42px;
    height: 42px;
    min-width: 42px;
    background-color: #f3edf8;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    line-height: 1;
  }
  .coming-title {
    font-size: 15px;
    font-weight: 700;
    color: #2d1a3e;
    margin: 0 0 4px 0;
  }
  .coming-body {
    font-size: 13px;
    line-height: 1.6;
    color: #777777;
    margin: 0;
  }

  /* ── CTA buttons ── */
  .cta-section {
    padding: 8px 40px 44px;
    background: #ffffff;
    text-align: center;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }
  .btn-outline-purple {
    display: inline-block;
    background-color: #f3edf8;
    color: #7c4a8f;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    padding: 11px 20px;
    border-radius: 50px;
    border: 2px solid #c5a8d8;
    transition: background 0.15s;
  }
  .btn-outline-purple:hover { background-color: #e8daf4; text-decoration: none; }
  .btn-filled-purple {
    display: inline-block;
    background-color: #7c4a8f;
    color: #ffffff;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    padding: 11px 20px;
    border-radius: 50px;
    transition: background 0.15s;
  }
  .btn-filled-purple:hover { background-color: #5f3570; text-decoration: none; }

  /* ── Sign off ── */
  .signoff-section {
    padding: 32px 40px;
    background-color: #faf8fd;
    text-align: center;
  }
  .signoff-quote {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 16px;
    line-height: 1.7;
    color: #2d1a3e;
    font-style: italic;
    margin: 0 0 12px 0;
  }
  .signoff-attr {
    font-size: 13px;
    color: #888888;
    margin: 0;
  }

  /* ── Footer ── */
  .card-footer {
    background-color: #2d1a3e;
    padding: 28px 36px;
    text-align: center;
  }
  .footer-social-label {
    font-size: 12px;
    color: rgba(255,255,255,0.7);
    margin: 0 0 10px 0;
  }
  .footer-social-links {
    font-size: 12px;
    margin: 0 0 18px 0;
  }
  .footer-social-links a {
    color: #c5a8d8;
    text-decoration: none;
    font-weight: 700;
  }
  .footer-social-links a:hover { text-decoration: underline; }
  .footer-address {
    font-size: 11px;
    color: rgba(255,255,255,0.5);
    line-height: 1.7;
    margin: 0 0 14px 0;
  }
  .footer-address a { color: rgba(255,255,255,0.5); text-decoration: none; }
  .footer-address a:hover { text-decoration: underline; }
  .footer-back {
    font-size: 11px;
    color: rgba(255,255,255,0.4);
    margin: 0;
  }
  .footer-back a {
    color: rgba(255,255,255,0.5);
    text-decoration: underline;
  }

  /* ── Confetti animation ── */
  @keyframes confetti-fall {
    0%   { transform: translateY(-20px) rotate(0deg);   opacity: 1; }
    100% { transform: translateY(80px)  rotate(360deg); opacity: 0; }
  }
  .confetti-dot {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    animation: confetti-fall 1.2s ease-in forwards;
    pointer-events: none;
  }
  .confetti-wrap {
    position: relative;
    height: 0;
    overflow: visible;
  }

  /* Mobile */
  @media (max-width: 640px) {
    .card-header { padding: 22px 24px; }
    .hero-section { padding: 36px 24px 28px; }
    .divider { padding: 0 24px; }
    .mission-section { padding: 28px 24px; }
    .coming-section { padding: 28px 24px; }
    .cta-section { padding: 8px 24px 36px; }
    .signoff-section { padding: 28px 24px; }
    .card-footer { padding: 24px 20px; }
    .hero-heading { font-size: 22px; }
    .cta-row { flex-direction: column; align-items: center; }
    .btn-outline-purple, .btn-filled-purple { width: 100%; max-width: 280px; text-align: center; }
  }
</style>

<div class="page-bg">
  <div class="card-wrap">

    <!-- HEADER -->
    <div class="card-header">
      <div class="brand-name">Abbie's Angels</div>
      <div class="brand-sub">Supporting Families · Lockport, NY</div>
    </div>

    <!-- HERO GREETING -->
    <div class="hero-section">
      <!-- Confetti burst on load -->
      <div class="confetti-wrap" id="confetti-root" aria-hidden="true"></div>

      <p class="eyebrow">Welcome to the Family</p>
      <h1 class="hero-heading">You're officially part of something beautiful. 💛</h1>
      <p class="hero-body">
        Thank you for joining the Abbie's Angels community. You'll now receive updates on our events,
        caregiver resources, and the stories that make this mission so meaningful — all happening
        right here in Western New York.
      </p>
      <a href="https://abbiesangels.org" class="btn-primary">Visit Our Website →</a>
    </div>

    <!-- DIVIDER -->
    <div class="divider"><hr /></div>

    <!-- MISSION -->
    <div class="mission-section">
      <p class="eyebrow">Our Mission</p>
      <p class="mission-quote">&ldquo;No caregiver should ever feel alone in their hardest seasons.&rdquo;</p>
      <p class="mission-body">
        Abbie's Angels is a 501(c)(3) nonprofit surrounding caregivers and families of differently abled
        children in the WNY community with practical help, encouragement, and connection.
      </p>
    </div>

    <!-- DIVIDER -->
    <div class="divider"><hr /></div>

    <!-- WHAT'S COMING -->
    <div class="coming-section">
      <p class="eyebrow">What's Coming Your Way</p>

      <div class="coming-item">
        <div class="coming-icon">📅</div>
        <div>
          <p class="coming-title">Events &amp; Fundraisers</p>
          <p class="coming-body">Be the first to hear about our galas, meat raffles, awareness walks, and community gatherings in Lockport and the broader WNY area.</p>
        </div>
      </div>

      <div class="coming-item">
        <div class="coming-icon">💛</div>
        <div>
          <p class="coming-title">Caregiver Stories &amp; Resources</p>
          <p class="coming-body">Real stories from families in our community, plus local resources, respite opportunities, and ways to connect with others who understand.</p>
        </div>
      </div>

      <div class="coming-item">
        <div class="coming-icon">🙌</div>
        <div>
          <p class="coming-title">Volunteer &amp; Giving Opportunities</p>
          <p class="coming-body">Whether you want to show up, donate, or sponsor — we'll keep you in the loop on the most impactful ways to get involved right now.</p>
        </div>
      </div>
    </div>

    <!-- CTA BUTTONS -->
    <div class="cta-section">
      <div class="cta-row">
        <a href="/events" class="btn-outline-purple">📅 Upcoming Events</a>
        <a href="/volunteer" class="btn-outline-purple">🙌 Volunteer</a>
        <a href="/donate" class="btn-filled-purple">💛 Donate</a>
      </div>
    </div>

    <!-- SIGN OFF -->
    <div class="signoff-section">
      <p class="signoff-quote">
        &ldquo;Every share, every donation, every hour of service helps us walk alongside more families —
        in honor of Abbie and all of our community's warriors.&rdquo;
      </p>
      <p class="signoff-attr">— The Abbie's Angels Team</p>
    </div>

    <!-- FOOTER -->
    <div class="card-footer">
      <p class="footer-social-label">Follow along on social media:</p>
      <p class="footer-social-links">
        <a href="https://www.facebook.com/abbiesangels" target="_blank" rel="noopener">Facebook</a>
        &nbsp;·&nbsp;
        <a href="https://www.instagram.com/abbiesangels" target="_blank" rel="noopener">Instagram</a>
        &nbsp;·&nbsp;
        <a href="https://www.linkedin.com/company/abbiesangels" target="_blank" rel="noopener">LinkedIn</a>
      </p>
      <p class="footer-address">
        Abbie's Angels, Inc. &nbsp;|&nbsp; 36 Gaffney Rd., Lockport, NY 14094 &nbsp;|&nbsp; United States<br>
        <a href="mailto:abbiesangels17@gmail.com">abbiesangels17@gmail.com</a>
      </p>
      <p class="footer-back">
        <a href="/">← Back to Home</a>
      </p>
    </div>

  </div>
</div>

<script>
  // Confetti burst on load
  (function () {
    const root = document.getElementById('confetti-root');
    if (!root) return;
    const colors = ['#7c4a8f','#c5a8d8','#f5c842','#e87070','#5bb5a2','#f3a63a'];
    for (let i = 0; i < 28; i++) {
      const dot = document.createElement('div');
      dot.className = 'confetti-dot';
      dot.style.cssText = [
        `left: ${Math.random() * 100}%`,
        `top: 0`,
        `background: ${colors[Math.floor(Math.random() * colors.length)]}`,
        `animation-delay: ${(Math.random() * 0.6).toFixed(2)}s`,
        `animation-duration: ${(0.9 + Math.random() * 0.7).toFixed(2)}s`,
        `transform: rotate(${Math.random()*360}deg)`,
        `border-radius: ${Math.random() > 0.5 ? '50%' : '2px'}`,
      ].join(';');
      root.appendChild(dot);
    }
  })();
</script>
</Base>
