---
import Base from '../layouts/Base.astro';
import { getSingleton } from '../lib/sanity';

const sp = await getSingleton('sponsor');

const defaultTiers = [
  { name: 'Angel Sponsor', amount: '$5,000+', perks: 'Premier logo placement, VIP table for 10, social media features, and speaking opportunity.' },
  { name: 'Gold Sponsor', amount: '$2,500', perks: 'Logo on all event materials, 6 event tickets, and social media recognition.' },
  { name: 'Silver Sponsor', amount: '$1,000', perks: 'Logo on event signage, 4 event tickets, and website recognition.' },
  { name: 'Community Sponsor', amount: '$500', perks: 'Name on event program and website recognition.' },
];

const tierStyles = ['gold', 'silver', 'bronze', 'friend'];
const tiers = sp?.tiers?.length ? sp.tiers : defaultTiers;
const HS_PORTAL = sp?.hubspot_portal_id || '244584127';
const HS_REGION = sp?.hubspot_region || 'na2';
const HS_FORM_ID = sp?.hubspot_form_id || '66b7d818-d7ee-4821-a1ef-a91194219e3d';
---
<Base title="Sponsor — Abbie's Angels">
<style>
  .page-hero {
    background: linear-gradient(135deg, #fff8e7 0%, #ffffff 50%, #eaf1fb 100%);
    padding: 48px 16px 36px;
    border-bottom: 1px solid var(--border-soft);
    text-align: center;
  }
  .page-hero h1 { font-size: 2rem; color: var(--blue); font-weight: 800; margin-bottom: 10px; }
  .page-hero p { color: var(--text-muted); font-size: 1rem; max-width: 580px; margin: 0 auto; }
  main { max-width: 1000px; margin: 44px auto 64px; padding: 0 16px; }
  .card {
    background: #fff; border-radius: 16px; padding: 24px 28px;
    border: 1px solid var(--border-soft);
    box-shadow: 0 4px 16px rgba(15,23,42,0.05);
    margin-bottom: 24px;
  }
  .card h2 { font-size: 1.15rem; margin-bottom: 10px; color: var(--blue); font-weight: 800;
    border-left: 4px solid var(--gold); padding-left: 10px; }
  .card p { font-size: 0.95rem; color: var(--text-muted); margin-bottom: 10px; line-height: 1.7; }
  .tier-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; margin-top: 14px; }
  .tier {
    border-radius: 14px; padding: 20px; text-align: center;
    border: 2px solid var(--border-soft);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .tier:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(15,23,42,0.09); }
  .tier.gold { border-color: var(--gold); background: #fffbef; }
  .tier.silver { border-color: #b0bec5; background: #f9fafb; }
  .tier.bronze { border-color: #bf8a5e; background: #fdf8f4; }
  .tier.friend { border-color: var(--border-soft); background: #f7fafc; }
  .tier-name { font-size: 1rem; font-weight: 800; font-family: var(--font-display); margin-bottom: 4px; }
  .tier-amount { font-size: 1.7rem; font-weight: 800; color: var(--blue); font-family: var(--font-display); margin-bottom: 10px; }
  .tier-perks { font-size: 0.83rem; color: var(--text-muted); text-align: left; padding-left: 14px; }
  .tier-perks li { margin-bottom: 5px; }
  .tier-perks-text { font-size: 0.85rem; color: var(--text-muted); text-align: left; line-height: 1.55; }
  /* HubSpot embed */
  .hs-form-frame { width: 100%; }
  @media (max-width: 640px) { .page-hero h1 { font-size: 1.6rem; } }
</style>

<div class="page-hero">
  <h1>{sp?.heading || 'Become a Sponsor'}</h1>
  <p>{sp?.subheading || "Partner with Abbie's Angels to support caregivers in Western New York while connecting your brand to a cause that matters."}</p>
</div>

<main>
  <!-- Sponsorship Tiers -->
  <div class="card">
    <h2>Sponsorship Tiers</h2>
    <p>{sp?.tiers_intro || 'All sponsors receive recognition at our events and on our website. Higher tiers include additional visibility and benefits.'}</p>
    <div class="tier-grid">
      {tiers.map((tier: any, i: number) => (
        <div class={`tier ${tierStyles[i % tierStyles.length]}`}>
          <div class="tier-name">{tier.name}</div>
          <div class="tier-amount">{tier.amount}</div>
          {tier.perks && <p class="tier-perks-text">{tier.perks}</p>}
        </div>
      ))}
    </div>
  </div>

  <!-- HubSpot Sponsorship Inquiry Form -->
  <div class="card">
    <h2>{sp?.form_heading || 'Sponsorship Inquiry'}</h2>
    <p>{sp?.form_intro || "Interested in sponsoring? Fill out the form below and we'll reach out within 2 business days with a full sponsorship packet."}</p>
    <script is:inline src={`https://js-${HS_REGION}.hsforms.net/forms/embed/${HS_PORTAL}.js`} defer></script>
    <div class="hs-form-frame" data-region={HS_REGION} data-form-id={HS_FORM_ID} data-portal-id={HS_PORTAL}></div>
  </div>
</main>

<!-- Redirect to thank-you when HubSpot sponsor form submits -->
<script>
  window.addEventListener('message', function (event) {
    if (
      event.data &&
      typeof event.data === 'object' &&
      event.data.type === 'hsFormCallback' &&
      (event.data.eventName === 'onFormSubmitted' || event.data.eventName === 'onFormSubmit')
    ) {
      window.location.href = '/thank-you';
    }
  });
</script>
</Base>
