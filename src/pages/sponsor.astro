---
import Base from '../layouts/Base.astro';
---
<Base title="Sponsor an Event — Abbie's Angels">
<style>
  .page-hero {
    background: linear-gradient(135deg, #fffbea 0%, #ffffff 60%, #eaf1fb 100%);
    padding: 48px 16px 36px;
    border-bottom: 1px solid var(--border-soft);
    text-align: center;
  }
  .page-hero h1 { font-size: 2rem; color: var(--blue); font-weight: 800; margin-bottom: 10px; }
  .page-hero p { color: var(--text-muted); font-size: 1rem; max-width: 580px; margin: 0 auto; }
  main { max-width: 720px; margin: 44px auto 64px; padding: 0 16px; }
  .card {
    background: #fff; border-radius: 16px; padding: 32px;
    border: 1px solid var(--border-soft);
    box-shadow: 0 4px 16px rgba(15,23,42,0.05);
  }
  .card h2 { font-size: 1.15rem; margin-bottom: 10px; color: var(--blue); font-weight: 800;
    border-left: 4px solid var(--gold); padding-left: 10px; }
  .card p { font-size: 0.93rem; color: var(--text-muted); margin-bottom: 16px; line-height: 1.65; }
  /* HubSpot form frame */
  .hs-form-frame { width: 100%; }
</style>

<div class="page-hero">
  <h1>Sponsor Abbie's Angels</h1>
  <p>Your sponsorship directly funds events, activities, and resources for families of differently abled children in Western New York.</p>
</div>

<main>
  <div class="card">
    <h2>Sponsorship Inquiry</h2>
    <p>Fill out the form below and our team will reach out with sponsorship packages and next steps.</p>
    <script src="https://js-na2.hsforms.net/forms/embed/244584127.js" defer></script>
    <div class="hs-form-frame" data-region="na2" data-form-id="66b7d818-d7ee-4821-a1ef-a91194219e3d" data-portal-id="244584127"></div>
  </div>
</main>
</Base>
