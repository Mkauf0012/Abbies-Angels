---
import Base from '../layouts/Base.astro';
import { client } from '../lib/sanity';

const [page, photos] = await Promise.all([
  client.fetch(`*[_type == "gallery_settings"][0]`),
  client.fetch(`*[_type == "gallery_image" && published != false] | order(order asc, _createdAt asc)`),
]);
---
<Base title="Gallery – Abbie's Angels">
<style>
  .page-hero {
    background: radial-gradient(circle at top left, #ffffff, var(--bg-light));
    padding: 40px 16px 32px;
    border-bottom: 1px solid var(--border-soft);
  }
  .page-hero-inner { max-width: 1100px; margin: 0 auto; }
  .page-hero h1 { font-size: 2rem; color: var(--blue); margin-bottom: 8px; }
  .page-hero p { font-size: 1rem; color: var(--text-muted); max-width: 680px; }
  main { max-width: 1100px; margin: 36px auto 56px; padding: 0 16px; }
  h2 {
    font-size: 1.4rem; margin-bottom: 8px;
    border-left: 4px solid var(--gold); padding-left: 10px; color: var(--blue);
  }
  .section-intro { font-size: 0.97rem; color: var(--text-muted); margin-bottom: 16px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px; margin-top: 10px;
  }
  .tile {
    border-radius: 14px; border: 1px solid var(--border-soft);
    overflow: hidden; background: #fff;
    box-shadow: 0 6px 18px rgba(15,23,42,0.04);
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .tile:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(15,23,42,0.1); }
  .tile img { width: 100%; height: 220px; display: block; object-fit: cover; object-position: center; }
  .tile-body { padding: 10px 12px 12px; }
  .tile-body h3 { font-size: 1rem; margin-bottom: 4px; color: var(--blue); }
  .tile-body p { font-size: 0.9rem; color: var(--text-muted); margin: 0; }
  .no-content { text-align: center; padding: 48px 16px; color: var(--text-muted); font-size: 1rem; }

  /* Lightbox */
  dialog {
    padding: 0; border: none; border-radius: 16px;
    background: transparent; max-width: 90vw; max-height: 90vh;
    box-shadow: 0 24px 64px rgba(0,0,0,0.45);
  }
  dialog::backdrop { background: rgba(10,18,36,0.82); }
  .lightbox-inner {
    background: #fff; border-radius: 16px; overflow: hidden;
    display: flex; flex-direction: column; max-height: 90vh;
  }
  .lightbox-img-wrap {
    flex: 1; overflow: hidden; display: flex; align-items: center; justify-content: center;
    background: #f8f9fb;
  }
  .lightbox-img-wrap img {
    max-width: 80vw; max-height: 72vh; object-fit: contain; display: block;
  }
  .lightbox-footer {
    padding: 14px 20px 16px; border-top: 1px solid var(--border-soft);
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
  }
  .lightbox-caption { font-size: 0.95rem; color: var(--text-muted); }
  .lightbox-close {
    background: none; border: none; cursor: pointer; font-size: 1.5rem; line-height: 1;
    color: var(--text-muted); padding: 4px 8px; border-radius: 8px;
    transition: background 0.15s;
  }
  .lightbox-close:hover { background: var(--bg-light); }

  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
    .spotlight { grid-template-columns: 1fr; }
    .lightbox-img-wrap img { max-width: 92vw; max-height: 60vh; }
  }
</style>

<div class="page-hero">
  <div class="page-hero-inner">
    <h1>{page?.title || 'Gallery'}</h1>
    {page?.intro && <p>{page.intro}</p>}
  </div>
</div>

<main>
  <section>
    <h2>{page?.highlights_heading || 'Event Highlights'}</h2>
    {page?.highlights_intro && <p class="section-intro">{page.highlights_intro}</p>}
    {photos.length > 0 ? (
      <div class="grid">
        {photos.map((p: any) => (
          <div class="tile" data-lightbox data-src={p.image.startsWith('http') ? p.image : `/${p.image.replace(/^\//, '')}`} data-caption={p.title + (p.caption ? ' — ' + p.caption : '')}>
            {p.image && <img src={p.image.startsWith('http') ? p.image : `/${p.image.replace(/^\//, '')}`} alt={p.image_alt || p.title} loading="lazy" width="400" height="220" />}
            <div class="tile-body">
              <h3>{p.title}</h3>
              {p.caption && <p>{p.caption}</p>}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="no-content"><p>No gallery photos yet.</p></div>
    )}
  </section>
</main>

<!-- Lightbox dialog -->
<dialog id="lightbox" aria-modal="true" aria-label="Image lightbox">
  <div class="lightbox-inner">
    <div class="lightbox-img-wrap">
      <img id="lightbox-img" src="" alt="" />
    </div>
    <div class="lightbox-footer">
      <span class="lightbox-caption" id="lightbox-caption"></span>
      <button class="lightbox-close" id="lightbox-close" aria-label="Close lightbox">&times;</button>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const cap = document.getElementById('lightbox-caption') as HTMLElement;
  const closeBtn = document.getElementById('lightbox-close') as HTMLButtonElement;

  document.querySelectorAll('[data-lightbox]').forEach(tile => {
    tile.addEventListener('click', () => {
      const src = (tile as HTMLElement).dataset.src || '';
      const caption = (tile as HTMLElement).dataset.caption || '';
      img.src = src;
      img.alt = caption;
      cap.textContent = caption;
      dialog.showModal();
    });
  });

  closeBtn.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') dialog.close(); });
</script>
</Base>
