---
import Base from '../layouts/Base.astro';
import { getSingleton } from '../lib/sanity';

const d = await getSingleton('donate');
const defaultOptions = [
  { label: 'Swipe/Any Payment', url: 'https://swipesimple.com/links/lnk_63b974d652acdaebbf87cd7c06d125e0', visible: true },
  { label: 'PayPal', url: 'https://www.paypal.com/ncp/payment/RANGVJHJ5FRQJ', visible: true },
  { label: 'Zelle', url: 'https://enroll.zellepay.com/qr-codes?data=eyJuYW1lIjoiQUJCSUVTIEFOR0VMUyBGT1VOREFUSU9OIElOQyIsInRva2VuIjoiYWJiaWVzYW5nZWxzIn0=', visible: true },
];
const configured = Array.isArray(d?.donate_options) ? d.donate_options : [];
const options = (configured.length ? configured : defaultOptions)
  .filter((o: any) => o && o.visible !== false && o.url && o.label);
---
<Base title="Donate — Abbie's Angels">
<style>
  .page-hero {
    background: linear-gradient(135deg, #fff0f0 0%, #ffffff 60%, #fff8e7 100%);
    padding: 48px 16px 36px;
    border-bottom: 1px solid var(--border-soft);
    text-align: center;
  }
  .page-hero h1 { font-size: 2rem; color: var(--blue); font-weight: 800; margin-bottom: 10px; }
  .page-hero p { color: var(--text-muted); font-size: 1rem; max-width: 560px; margin: 0 auto; }
  main { max-width: 640px; margin: 44px auto 64px; padding: 0 16px; text-align: center; }
  .donate-card {
    background: #fff; border-radius: 20px; padding: 40px 32px;
    border: 1px solid var(--border-soft);
    box-shadow: 0 8px 32px rgba(15,23,42,0.07);
  }
  .donate-card .heart { font-size: 3rem; margin-bottom: 16px; }
  .donate-card h2 { font-size: 1.4rem; color: var(--blue); font-weight: 800; margin-bottom: 12px; }
  .donate-card p { font-size: 0.97rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 16px; }
  .donate-options { display: flex; flex-direction: column; align-items: center; gap: 12px; margin-bottom: 8px; }
  .btn-donate {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    padding: 14px 36px; border-radius: 999px; font-size: 1.05rem; font-weight: 800;
    font-family: var(--font-display); border: none; cursor: pointer;
    text-decoration: none; background: #008CFF; color: #fff;
    box-shadow: 0 4px 18px rgba(0,140,255,0.35);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }
  .btn-donate:hover { background: #0070cc; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,140,255,0.4); text-decoration: none; }
  .venmo-note { margin-top: 18px; font-size: 0.85rem; color: var(--text-muted); }
  .give-section { margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--border-soft); text-align: left; }
  .give-section h3 { font-size: 1.05rem; font-weight: 800; color: var(--blue); margin-bottom: 8px; }
  .give-section p { font-size: 0.9rem; color: var(--text-muted); margin-bottom: 8px; }
  .give-section address { font-style: normal; font-size: 0.92rem; color: var(--text-main); margin-bottom: 8px; }
  .btn-secondary {
    display: inline-flex; align-items: center; gap: 6px; margin-top: 6px;
    padding: 9px 20px; border-radius: 999px; font-size: 0.9rem; font-weight: 700;
    font-family: var(--font-display); text-decoration: none;
    background: var(--gold); color: #000; transition: transform 0.15s, background 0.15s;
  }
  .btn-secondary:hover { background: #e0a010; transform: translateY(-1px); text-decoration: none; }
  .ein-note { margin-top: 24px; font-size: 0.78rem; color: var(--text-muted); text-align: center; }
</style>

<div class="page-hero">
  <h1>{d?.heading || 'Make a Donation'}</h1>
  <p>{d?.subheading || 'Every dollar goes directly toward events, activities, and resources for families of differently abled children in Western New York.'}</p>
</div>

<main>
  <div class="donate-card">
    <div class="heart">&#10084;&#65039;</div>
    <div class="donate-options">
      {options.map((o: any) => (
        <a class="btn-donate" href={o.url} target="_blank" rel="noopener noreferrer">{o.label}</a>
      ))}
    </div>

    {d?.mail_address && (
      <div class="give-section">
        <h3>Donate by Mail</h3>
        <address>{d.mail_address}</address>
        <p>Please include your name and mailing address so we can send a thank-you and receipt.</p>
      </div>
    )}

    {d?.sponsor_cta && (
      <div class="give-section">
        <h3>Corporate &amp; Event Sponsorship</h3>
        <p>{d.sponsor_cta}</p>
        <a class="btn-secondary" href="/sponsor">View Sponsorship Opportunities</a>
      </div>
    )}

    {!d?.mail_address && !d?.sponsor_cta && (
      <div class="give-section">
        <h3>Other Ways to Give</h3>
        <p>Prefer to donate by check? Make it payable to <strong>Abbie's Angels</strong> and mail to our address on the <a href="/contact">Contact page</a>.</p>
        <p>Interested in corporate sponsorship? <a href="/sponsor">Learn about sponsorship opportunities →</a></p>
      </div>
    )}

    {d?.ein_note && <p class="ein-note">{d.ein_note}</p>}
  </div>
</main>
</Base>
