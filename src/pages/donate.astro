---
import Base from '../layouts/Base.astro';
import { createClient } from '@sanity/client';

const client = createClient({
  projectId: '7o31gm3n',
  dataset: 'production',
  apiVersion: '2024-01-01',
  useCdn: true,
});

const [support, donate] = await Promise.all([
  client.fetch(`*[_type == "support"][0]`),
  client.fetch(`*[_type == "donate"][0]`),
]);

// Auctria URL: donate page override → support card_link_url → fallback
const auctriaUrl = donate?.online_section?.button_url || support?.card_link_url || 'https://www.auctria.com/';
---
<Base title="Donate — Abbie's Angels" description="Support Abbie's Angels with a donation. Every dollar helps caregivers and families of differently abled children in Western New York.">
<main>

  <!-- HERO -->
  <section class="page-hero">
    <div class="page-hero-inner">
      <span class="section-tag">Make a Difference</span>
      <h1>{donate?.hero_heading || 'Support Abbie\'s Angels'}</h1>
      <p>{donate?.hero_subheading || 'Every dollar surrounds caregivers and families with practical help, encouragement, and connection as they navigate complex medical needs with their differently abled children.'}</p>
    </div>
  </section>

  <!-- DONATE OPTIONS -->
  <section class="donate-section">
    <div class="donate-inner">

      <!-- Online Donation Card -->
      <div class="donate-card primary-card">
        <div class="card-icon">💳</div>
        <h2>{donate?.online_section?.heading || 'Donate Online'}</h2>
        <p>{donate?.online_section?.body || 'Make a secure donation through our online giving platform. One-time or recurring gifts accepted.'}</p>
        <a href={auctriaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-donate">
          {donate?.online_section?.button_text || 'Donate Now'}
        </a>
      </div>

      <!-- Mail-in Check Card -->
      <div class="donate-card">
        <div class="card-icon">✉️</div>
        <h2>{donate?.check_section?.heading || 'Mail a Check'}</h2>
        <p>{donate?.check_section?.body || 'Make checks payable to Abbie\'s Angels and mail to:'}</p>
        <address>
          {donate?.check_section?.address || 'Abbie\'s Angels'}<br/>
          {donate?.check_section?.city_state_zip || 'Lockport, NY 14094'}
        </address>
        <p class="ein-note">EIN: 33-2629458 &bull; 501(c)(3) Nonprofit</p>
      </div>

      <!-- Venmo / PayPal Card -->
      {donate?.venmo_section?.venmo_handle && (
        <div class="donate-card">
          <div class="card-icon">📱</div>
          <h2>{donate?.venmo_section?.heading || 'Venmo / PayPal'}</h2>
          <p>{donate?.venmo_section?.body || 'Quick and easy giving via Venmo or PayPal.'}</p>
          {donate?.venmo_section?.venmo_handle && (
            <p class="handle">Venmo: <strong>@{donate.venmo_section.venmo_handle}</strong></p>
          )}
          {donate?.venmo_section?.paypal_handle && (
            <p class="handle">PayPal: <strong>@{donate.venmo_section.paypal_handle}</strong></p>
          )}
        </div>
      )}

    </div>
  </section>

  <!-- WHY DONATE -->
  <section class="why-donate">
    <div class="why-inner">
      <h2>{donate?.impact_heading || 'Your Gift Makes an Impact'}</h2>
      <div class="impact-grid">
        <div class="impact-item">
          <span class="impact-icon">🎉</span>
          <p>Funds community events that bring families joy and connection</p>
        </div>
        <div class="impact-item">
          <span class="impact-icon">🎓</span>
          <p>Provides scholarships and grants for therapies and equipment</p>
        </div>
        <div class="impact-item">
          <span class="impact-icon">🤝</span>
          <p>Supports caregiver resources and peer support programs</p>
        </div>
        <div class="impact-item">
          <span class="impact-icon">💛</span>
          <p>Ensures no family faces their journey alone</p>
        </div>
      </div>
    </div>
  </section>

  <!-- NEWSLETTER SIGNUP -->
  <section class="newsletter">
    <div class="newsletter-inner">
      <h2>Stay Connected</h2>
      <p>Sign up for updates on events, stories, and ways to help.</p>
      <div style="display:flex;gap:10px;max-width:460px;margin:0 auto;flex-wrap:wrap;">
        <input type="email" placeholder="Your email address" style="flex:1;padding:10px 16px;border-radius:999px;border:1px solid var(--border-soft); font-size:0.95rem;">
        <a href="/thank-you" class="btn btn-donate" style="padding:10px 22px; font-size:0.93rem;">Subscribe</a>
      </div>
    </div>
  </section>

</main>
</Base>

<style>
  :root {
    --gold: #f4b321;
    --blue: #0055a4;
    --accent-red: #c8102e;
    --text-main: #1a202c;
    --text-muted: #5a6475;
    --border-soft: #e2e8f0;
    --font-display: 'Nunito', system-ui, sans-serif;
    --font-body: 'Lato', system-ui, sans-serif;
  }

  .page-hero {
    background: linear-gradient(135deg, #f0f5ff 0%, #fff8e7 100%);
    padding: clamp(2.5rem, 5vw, 4rem) 24px;
    text-align: center;
  }
  .page-hero-inner { max-width: 680px; margin: 0 auto; }
  .section-tag {
    display: inline-block;
    background: #fff3cd;
    color: #7a5100;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }
  .page-hero h1 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 800;
    color: #0d1f3c;
    margin-bottom: 1rem;
    font-family: var(--font-display);
  }
  .page-hero p {
    font-size: 1.05rem;
    color: #4a5568;
    line-height: 1.7;
  }

  .donate-section { padding: clamp(2.5rem, 5vw, 4rem) 24px; background: #fff; }
  .donate-inner {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .donate-card {
    background: #f9fafb;
    border: 1px solid var(--border-soft);
    border-radius: 16px;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .donate-card.primary-card {
    background: #fff;
    border-color: var(--blue);
    box-shadow: 0 4px 20px rgba(0,85,164,0.12);
  }
  .card-icon { font-size: 2rem; }
  .donate-card h2 {
    font-size: 1.2rem;
    font-weight: 800;
    color: #0d1f3c;
    font-family: var(--font-display);
  }
  .donate-card p { font-size: 0.95rem; color: var(--text-muted); line-height: 1.65; }
  .donate-card address { font-style: normal; font-size: 0.95rem; color: var(--text-main); line-height: 1.7; }
  .ein-note { font-size: 0.8rem; color: var(--text-muted); margin-top: auto; }
  .handle { font-size: 0.95rem; color: var(--text-main); }

  .btn { display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; font-weight: 700; text-decoration: none; transition: background 0.15s, transform 0.15s; margin-top: auto; }
  .btn-donate { background: var(--accent-red); color: #fff; padding: 12px 28px; font-size: 1rem; box-shadow: 0 2px 8px rgba(200,16,46,0.25); }
  .btn-donate:hover { background: #9e0b23; transform: translateY(-1px); text-decoration: none; }

  .why-donate { background: #f7fafc; padding: clamp(2.5rem, 5vw, 4rem) 24px; text-align: center; }
  .why-inner { max-width: 900px; margin: 0 auto; }
  .why-inner h2 { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 800; color: #0d1f3c; margin-bottom: 2rem; font-family: var(--font-display); }
  .impact-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.5rem; }
  .impact-item { background: #fff; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
  .impact-icon { font-size: 1.75rem; display: block; margin-bottom: 0.5rem; }
  .impact-item p { font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; }

  .newsletter { background: #0055a4; padding: clamp(2.5rem, 5vw, 4rem) 24px; text-align: center; }
  .newsletter-inner { max-width: 560px; margin: 0 auto; }
  .newsletter h2 { font-size: 1.6rem; font-weight: 800; color: #fff; margin-bottom: 0.5rem; font-family: var(--font-display); }
  .newsletter p { color: rgba(255,255,255,0.85); margin-bottom: 1.5rem; }
</style>
